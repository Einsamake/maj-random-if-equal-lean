        {
          "item": "低模型误判",
          "calculation": "(2n/9)/(n/12)^2=32/n；n=100时32/100=8/25"
        },
        {
          "item": "高模型误判",
          "calculation": "(n/4)/(n/12)^2=36/n；n=100时36/100=9/25"
        },
        {
          "item": "各半先验",
          "calculation": "(8/25+9/25)/2=17/50；1-17/50=33/50=66%"
