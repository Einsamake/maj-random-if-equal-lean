module

public import MathResearchAnalysis.NextRing
public import MathResearchAnalysis.ExponentialClocks
public import Mathlib.Data.Set.Finite.Lattice

set_option autoImplicit false

/-!
# The common physical history of arrival streams

The filtration is generated by all events saying that a particular ring has
arrived by an observed time. Individual arrivals are proved to be stopping
times in this common history; their stopping-time status is not an input.
-/

public noncomputable section

open MeasureTheory Set Filter

namespace MathResearchAnalysis.ArrivalFiltration

variable {Ω V : Type*} {mΩ : MeasurableSpace Ω}

/-- Information obtainable by observing all sites' arrivals up to physical time `t`. -/
@[expose] def history (A : V → Nat → Ω → ℝ)
    (hA : ∀ v k, Measurable (A v k)) : Filtration ℝ mΩ where
  seq t := MeasurableSpace.generateFrom
    {s | ∃ v k u, u ≤ t ∧ s = {ω | A v k ω ≤ u}}
  mono' s t hst := MeasurableSpace.generateFrom_mono (by
    rintro _ ⟨v, k, u, hut, rfl⟩
    exact ⟨v, k, u, hut.trans hst, rfl⟩)
  le' t := MeasurableSpace.generateFrom_le (by
    rintro _ ⟨v, k, u, _, rfl⟩
    exact measurableSet_le (hA v k) measurable_const)

/-- Every observation about an arrival by `u ≤ t` belongs to the actual history at `t`. -/
theorem arrival_event_measurable (A : V → Nat → Ω → ℝ)
    (hA : ∀ v k, Measurable (A v k)) (v : V) (k : Nat)
    {u t : ℝ} (hut : u ≤ t) :
    MeasurableSet[history A hA t] {ω | A v k ω ≤ u} :=
  MeasurableSpace.measurableSet_generateFrom ⟨v, k, u, hut, rfl⟩

/-- The arrival stopping-time property follows from the definition of the history. -/
theorem arrival_isStoppingTime (A : V → Nat → Ω → ℝ)
    (hA : ∀ v k, Measurable (A v k)) (v : V) (k : Nat) :
    IsStoppingTime (history A hA) (fun ω => (A v k ω : WithTop ℝ)) := by
  intro t
  convert arrival_event_measurable A hA v k (le_refl t) using 1
  ext ω
  simp only [Set.mem_ofPred_eq, WithTop.coe_le_coe]

/-- The generated common history is no larger than any history observing these arrivals. -/
theorem history_le_of_arrivals_stopping (A : V → Nat → Ω → ℝ)
    (hA : ∀ v k, Measurable (A v k)) (ℱ : Filtration ℝ mΩ)
    (hstop : ∀ v k, IsStoppingTime ℱ (fun ω => (A v k ω : WithTop ℝ)))
    (t : ℝ) : history A hA t ≤ ℱ t := by
  apply MeasurableSpace.generateFrom_le
  rintro _ ⟨v, k, u, hut, rfl⟩
  have hevent : MeasurableSet[ℱ u] {ω | A v k ω ≤ u} := by
    simpa only [WithTop.coe_le_coe] using hstop v k u
  exact ℱ.mono hut _ hevent

/-- The strict next ring is a stopping time in the generated physical history. -/
theorem extendedNextRing_isStoppingTime (A : V → Nat → Ω → ℝ)
    (hA : ∀ v k, Measurable (A v k)) (v : V) (ready : Ω → ℝ)
    (hmono : ∀ ω, Monotone (fun k => A v k ω))
    (hr : IsStoppingTime (history A hA) (fun ω => (ready ω : WithTop ℝ))) :
    IsStoppingTime (history A hA) (NextRing.extendedNextRing (A v) ready) :=
  NextRing.extendedNextRing_isStoppingTime (history A hA) (A v) ready hmono hr
    (arrival_isStoppingTime A hA v)

/-! Total chronological representatives of the genuine exponential streams.
Clipping negative gaps changes only a null set, but supplies pointwise
monotonicity required by the stopping-time event identity. -/

@[expose] def chronologicalArrival (v : V) (n : Nat)
    (ω : ExponentialClocks.Sample V) : ℝ :=
  ∑ k ∈ Finset.range (n + 1), max (ExponentialClocks.gap v k ω) 0

theorem chronologicalArrival_measurable (v : V) (n : Nat) :
    Measurable (chronologicalArrival v n) := by
  unfold chronologicalArrival
  exact Finset.measurable_sum _ (fun k _ =>
    (ExponentialClocks.gap_measurable v k).max measurable_const)

theorem chronologicalArrival_monotone (v : V) (ω : ExponentialClocks.Sample V) :
    Monotone (fun n => chronologicalArrival v n ω) := by
  apply monotone_nat_of_le_succ
  intro n
  unfold chronologicalArrival
  rw [Finset.sum_range_succ _ (n + 1)]
  exact le_add_of_nonneg_right
    (le_max_right (ExponentialClocks.gap v (n + 1) ω) (0 : ℝ))

theorem chronologicalArrival_eq_raw_ae [Countable V] :
    ∀ᵐ ω ∂ExponentialClocks.clockMeasure V, ∀ v n,
      chronologicalArrival v n ω = ExponentialClocks.arrival v n ω := by
  filter_upwards [ExponentialClocks.all_gaps_positive_ae (V := V)] with ω hω
  intro v n
  apply Finset.sum_congr rfl
  intro k _
  exact max_eq_left (hω v k).le

theorem chronologicalArrival_unbounded_ae [Countable V] :
    ∀ᵐ ω ∂ExponentialClocks.clockMeasure V, ∀ v,
      Tendsto (fun n => chronologicalArrival v n ω) atTop atTop := by
  filter_upwards [chronologicalArrival_eq_raw_ae (V := V),
    ExponentialClocks.arrival_unbounded_ae (V := V)] with ω heq hω
  intro v
  simpa only [heq v] using hω v

/-- The actual common physical history for all the constructed clock streams. -/
@[expose] def clockHistory (V : Type*) :
    Filtration ℝ (inferInstance : MeasurableSpace (ExponentialClocks.Sample V)) :=
  history chronologicalArrival chronologicalArrival_measurable

theorem clock_arrival_isStoppingTime (v : V) (n : Nat) :
    IsStoppingTime (clockHistory V)
      (fun ω => (chronologicalArrival v n ω : WithTop ℝ)) :=
  arrival_isStoppingTime chronologicalArrival chronologicalArrival_measurable v n

/-- A strict next arrival is a stopping time of the actual generated clock history. -/
theorem clock_next_isStoppingTime (v : V) (ready : ExponentialClocks.Sample V → ℝ)
    (hr : IsStoppingTime (clockHistory V) (fun ω => (ready ω : WithTop ℝ))) :
    IsStoppingTime (clockHistory V) (NextRing.extendedNextRing (chronologicalArrival v) ready) :=
  extendedNextRing_isStoppingTime chronologicalArrival chronologicalArrival_measurable v
    ready (chronologicalArrival_monotone v) hr

theorem clock_future_arrival_ae [Countable V] (v : V)
    (ready : ExponentialClocks.Sample V → ℝ) :
    ∀ᵐ ω ∂ExponentialClocks.clockMeasure V,
      ∃ n, ready ω < chronologicalArrival v n ω := by
  filter_upwards [chronologicalArrival_unbounded_ae (V := V)] with ω hω
  obtain ⟨N, hN⟩ := eventually_atTop.mp ((tendsto_atTop.mp (hω v)) (ready ω + 1))
  exact ⟨N, lt_of_lt_of_le (by linarith) (hN N le_rfl)⟩

/-- Almost-sure next-ring finiteness follows from the constructed probability model. -/
theorem clock_next_finite_ae [Countable V] (v : V)
    (ready : ExponentialClocks.Sample V → ℝ) :
    ∀ᵐ ω ∂ExponentialClocks.clockMeasure V,
      NextRing.extendedNextRing (chronologicalArrival v) ready ω ≠ ⊤ :=
  NextRing.extendedNextRing_ae_ne_top (chronologicalArrival v) ready
    (clock_future_arrival_ae v ready)

theorem clock_next_infinite_measure_zero [Countable V] (v : V)
    (ready : ExponentialClocks.Sample V → ℝ) :
    ExponentialClocks.clockMeasure V
      {ω | NextRing.extendedNextRing (chronologicalArrival v) ready ω = ⊤} = 0 :=
  NextRing.measure_extendedNextRing_top_eq_zero (chronologicalArrival v) ready
    (clock_future_arrival_ae v ready)

theorem clock_next_strict (v : V) (ready : ExponentialClocks.Sample V → ℝ)
    (ω : ExponentialClocks.Sample V) :
    (ready ω : WithTop ℝ) < NextRing.extendedNextRing (chronologicalArrival v) ready ω :=
  NextRing.ready_lt_extendedNextRing (chronologicalArrival v) ready ω

theorem finite_arrivals_below (v : V) (ω : ExponentialClocks.Sample V)
    (hunbounded : Tendsto (fun n => chronologicalArrival v n ω) atTop atTop) (t : ℝ) :
    Set.Finite {n : Nat | chronologicalArrival v n ω ≤ t} := by
  obtain ⟨N, hN⟩ := eventually_atTop.mp ((tendsto_atTop.mp hunbounded) (t + 1))
  apply (Finset.range N).finite_toSet.subset
  intro n hn
  apply Finset.mem_range.mpr
  by_contra hnot
  have hlate := hN n (Nat.le_of_not_gt hnot)
  simp only [Set.mem_ofPred_eq] at hn
  linarith

theorem clock_locally_finite_ae [Countable V] :
    ∀ᵐ ω ∂ExponentialClocks.clockMeasure V, ∀ v t,
      Set.Finite {n : Nat | chronologicalArrival v n ω ≤ t} := by
  filter_upwards [chronologicalArrival_unbounded_ae (V := V)] with ω hω
  exact fun v t => finite_arrivals_below v ω (hω v) t

/-- For finitely many sites, local finiteness gives a genuinely finite event word. -/
theorem finite_clock_events [Finite V] (ω : ExponentialClocks.Sample V)
    (hunbounded : ∀ v, Tendsto (fun n => chronologicalArrival v n ω) atTop atTop) (t : ℝ) :
    Set.Finite {event : V × Nat | chronologicalArrival event.1 event.2 ω ≤ t} := by
  have hfinite := Set.finite_iUnion (fun v : V =>
    (finite_arrivals_below v ω (hunbounded v) t).image (Prod.mk v))
  have heq : {event : V × Nat | chronologicalArrival event.1 event.2 ω ≤ t} =
      ⋃ v : V, (Prod.mk v) '' {n : Nat | chronologicalArrival v n ω ≤ t} := by
    ext event
    rcases event with ⟨v, n⟩
    simp
  rw [heq]
  exact hfinite

theorem finite_clock_events_ae [Fintype V] :
    ∀ᵐ ω ∂ExponentialClocks.clockMeasure V, ∀ t : ℝ,
      Set.Finite {event : V × Nat | chronologicalArrival event.1 event.2 ω ≤ t} := by
  filter_upwards [chronologicalArrival_unbounded_ae (V := V)] with ω hω
  exact fun t => finite_clock_events ω hω t

end MathResearchAnalysis.ArrivalFiltration
