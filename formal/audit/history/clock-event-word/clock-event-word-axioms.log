MathResearchAnalysis.ClockEventWord.eventTime.{u_1} {V : Type u_1} (ω : MathResearchAnalysis.ExponentialClocks.Sample V)
  (e : MathResearchAnalysis.ClockEventWord.Event V) : ℝ
MathResearchAnalysis.ClockEventWord.eventSet.{u_1} {V : Type u_1} (ω : MathResearchAnalysis.ExponentialClocks.Sample V)
  (t : ℝ) : Set (MathResearchAnalysis.ClockEventWord.Event V)
MathResearchAnalysis.ClockEventWord.word.{u_1} {V : Type u_1} (ω : MathResearchAnalysis.ExponentialClocks.Sample V)
  (t : ℝ) : List (MathResearchAnalysis.ClockEventWord.Event V)
MathResearchAnalysis.ClockEventWord.word_spec_ae.{u_1} {V : Type u_1} [Fintype V] :
  ∀ᵐ (ω : MathResearchAnalysis.ExponentialClocks.Sample V) ∂MathResearchAnalysis.ExponentialClocks.clockMeasure V,
    ∀ (t : ℝ),
      (∀ (e : MathResearchAnalysis.ClockEventWord.Event V),
          e ∈ MathResearchAnalysis.ClockEventWord.word ω t ↔ MathResearchAnalysis.ClockEventWord.eventTime ω e ≤ t) ∧
        (MathResearchAnalysis.ClockEventWord.word ω t).Nodup ∧
          List.Pairwise
              (fun a b =>
                MathResearchAnalysis.ClockEventWord.eventTime ω b < MathResearchAnalysis.ClockEventWord.eventTime ω a)
              (MathResearchAnalysis.ClockEventWord.word ω t) ∧
            ∀ e ∈ MathResearchAnalysis.ClockEventWord.word ω t,
              0 < MathResearchAnalysis.ClockEventWord.eventTime ω e ∧
                MathResearchAnalysis.ClockEventWord.eventTime ω e ≤ t
