import Std

set_option autoImplicit false

/-!
Finite deterministic update words and permitted adjacent swaps.

Only the explicit commutation assumptions below are used.  No claim about
random schedules, time bounds, or the completion of an infinite execution is
part of this module.
-/

namespace MathResearch.Trace

universe u v

variable {Label : Type u} {State : Type v}

/-- Execute labels from left to right, starting from `initial`. -/
def execute (update : Label → State → State) (word : List Label)
    (initial : State) : State :=
  word.foldl (fun state label => update label state) initial

@[simp] theorem execute_nil (update : Label → State → State) (initial : State) :
    execute update [] initial = initial := rfl

@[simp] theorem execute_cons (update : Label → State → State)
    (label : Label) (word : List Label) (initial : State) :
    execute update (label :: word) initial =
      execute update word (update label initial) := rfl

theorem execute_append (update : Label → State → State)
    (first second : List Label) (initial : State) :
    execute update (first ++ second) initial =
      execute update second (execute update first initial) := by
  induction first generalizing initial with
  | nil => rfl
  | cons label rest ih =>
      simpa only [List.cons_append, execute_cons] using
        ih (update label initial)

/-- The two deterministic update functions commute on every state. -/
def Commutes (update : Label → State → State) (a b : Label) : Prop :=
  ∀ state, update b (update a state) = update a (update b state)

theorem commutes_symm (update : Label → State → State) {a b : Label}
    (h : Commutes update a b) : Commutes update b a := by
  intro state
  exact (h state).symm

/-- A permitted adjacent swap also preserves execution in any context. -/
theorem execute_adjacent_swap (update : Label → State → State)
    (pre suffix : List Label) (a b : Label)
    (h : Commutes update a b) (initial : State) :
    execute update (pre ++ a :: b :: suffix) initial =
      execute update (pre ++ b :: a :: suffix) initial := by
  simp only [execute_append, execute_cons]
  rw [h]

/--
Finite equivalence generated by swapping adjacent labels admitted by
`independent`, with an arbitrary unchanged pre and suffix.

The relation is defined independently of the semantic preservation theorem.
-/
inductive SwapEquivalent (independent : Label → Label → Prop) :
    List Label → List Label → Prop where
  | refl (word : List Label) : SwapEquivalent independent word word
  | swap (pre suffix : List Label) (a b : Label)
      (allowed : independent a b) :
      SwapEquivalent independent (pre ++ a :: b :: suffix)
        (pre ++ b :: a :: suffix)
  | symm {first second : List Label} :
      SwapEquivalent independent first second →
        SwapEquivalent independent second first
  | trans {first second third : List Label} :
      SwapEquivalent independent first second →
      SwapEquivalent independent second third →
        SwapEquivalent independent first third

/--
Any finite chain of permitted swaps preserves the resulting state, provided
every permitted pair really commutes as deterministic functions.
-/
theorem execute_eq_of_swapEquivalent
    (update : Label → State → State)
    (independent : Label → Label → Prop)
    (sound : ∀ a b, independent a b → Commutes update a b)
    {first second : List Label}
    (equivalent : SwapEquivalent independent first second) :
    ∀ initial, execute update first initial = execute update second initial := by
  induction equivalent with
  | refl word => intro initial; rfl
  | swap pre suffix a b allowed =>
      exact execute_adjacent_swap update pre suffix a b
        (sound a b allowed)
  | symm h ih =>
      intro initial
      exact (ih initial).symm
  | trans h₁ h₂ ih₁ ih₂ =>
      intro initial
      exact (ih₁ initial).trans (ih₂ initial)

/-- Specialization in which the permitted swaps are precisely commuting pairs. -/
theorem execute_eq_of_commuting_swaps
    (update : Label → State → State) {first second : List Label}
    (equivalent : SwapEquivalent (Commutes update) first second)
    (initial : State) :
    execute update first initial = execute update second initial :=
  execute_eq_of_swapEquivalent update (Commutes update)
    (fun _ _ h => h) equivalent initial

/-- Permitted swaps preserve the multiset of update occurrences. -/
theorem swapEquivalent_perm
    (independent : Label → Label → Prop) {first second : List Label}
    (equivalent : SwapEquivalent independent first second) :
    first.Perm second := by
  induction equivalent with
  | refl word => exact List.Perm.refl word
  | swap pre suffix a b allowed =>
      have h : (a :: b :: suffix).Perm (b :: a :: suffix) :=
        List.Perm.swap b a suffix
      induction pre with
      | nil => exact h
      | cons label rest ih => exact List.Perm.cons label ih
  | symm h ih => exact ih.symm
  | trans h₁ h₂ ih₁ ih₂ => exact ih₁.trans ih₂

theorem swapEquivalent_prepend
    (independent : Label → Label → Prop) (label : Label)
    {first second : List Label}
    (equivalent : SwapEquivalent independent first second) :
    SwapEquivalent independent (label :: first) (label :: second) := by
  induction equivalent with
  | refl word => exact SwapEquivalent.refl _
  | swap pre suffix a b allowed =>
      simpa only [List.cons_append] using
        SwapEquivalent.swap (label :: pre) suffix a b allowed
  | symm h ih => exact SwapEquivalent.symm ih
  | trans h₁ h₂ ih₁ ih₂ => exact SwapEquivalent.trans ih₁ ih₂

/-- Pull one event to the front across a pre of independent events. -/
theorem swapEquivalent_move_to_front
    (independent : Label → Label → Prop) (a : Label) :
    ∀ (pre suffix : List Label),
      (∀ b, b ∈ pre → independent b a) →
      SwapEquivalent independent (pre ++ a :: suffix)
        (a :: (pre ++ suffix)) := by
  intro pre
  induction pre with
  | nil =>
      intro suffix allowed
      exact SwapEquivalent.refl _
  | cons b rest ih =>
      intro suffix allowed
      have rest_allowed : ∀ c, c ∈ rest → independent c a := by
        intro c hc
        exact allowed c (List.mem_cons_of_mem b hc)
      have tail_swaps := swapEquivalent_prepend independent b
        (ih suffix rest_allowed)
      have head_swap := SwapEquivalent.swap ([] : List Label)
        (rest ++ suffix) b a (allowed b (by simp))
      simpa only [List.cons_append, List.nil_append] using
        SwapEquivalent.trans tail_swaps head_swap

/-! Conflict-order characterization for words with unique event identifiers. -/

/-- An occurrence of `a` precedes an occurrence of `b` in the word. -/
def Before (a b : Label) (word : List Label) : Prop :=
  [a, b].Sublist word

/-- Every pair that is not declared independent retains its original order. -/
def PreservesConflictOrder (independent : Label → Label → Prop)
    (first second : List Label) : Prop :=
  ∀ a b, ¬ independent a b → Before a b first → Before a b second

private theorem pair_sublist_tail_of_ne {a b head : Label} {tail : List Label}
    (different : a ≠ head) (sublist : [a, b].Sublist (head :: tail)) :
    [a, b].Sublist tail := by
  cases sublist with
  | cons _ rest => exact rest
  | cons_cons _ rest => exact False.elim (different rfl)

/--
A permutation of a word with no repeated event identifiers is generated by
permitted adjacent swaps if it preserves every conflicting pair's order.

This is a combinatorial theorem, independent of `execute` and `Commutes`.
Repeated updates at the same site can be represented by distinct event IDs.
-/
theorem swapEquivalent_of_perm_preserving_conflicts
    (independent : Label → Label → Prop) :
    ∀ (first second : List Label), first.Nodup → first.Perm second →
      PreservesConflictOrder independent first second →
      SwapEquivalent independent first second := by
  intro first second
  revert first
  induction second with
  | nil =>
      intro first unique permutation order
      have empty : first = [] := permutation.eq_nil
      subst first
      exact SwapEquivalent.refl []
  | cons a tail ih =>
      intro first unique permutation order
      have target_unique : (a :: tail).Nodup := permutation.nodup unique
      have a_not_in_tail : a ∉ tail := (List.nodup_cons.mp target_unique).1
      have a_in_first : a ∈ first := permutation.mem_iff.mpr (by simp)
      rcases List.mem_iff_append.mp a_in_first with ⟨pre, suffix, split⟩
      subst first
      have allowed : ∀ b, b ∈ pre → independent b a := by
        intro b member
        classical
        apply Classical.byContradiction
        intro conflict
        have before_source : Before b a (pre ++ a :: suffix) :=
          (List.singleton_sublist.mpr member).append
            (List.singleton_sublist.mpr (by simp))
        have before_target : [b, a].Sublist (a :: tail) :=
          order b a conflict before_source
        have a_in_tail : a ∈ tail :=
          List.singleton_sublist.mp before_target.of_cons_cons
        exact a_not_in_tail a_in_tail
      have move := swapEquivalent_move_to_front independent a pre suffix allowed
      have move_perm := swapEquivalent_perm independent move
      have moved_unique : (a :: (pre ++ suffix)).Nodup := move_perm.nodup unique
      have a_not_in_rest : a ∉ pre ++ suffix :=
        (List.nodup_cons.mp moved_unique).1
      have rest_unique : (pre ++ suffix).Nodup :=
        (List.nodup_cons.mp moved_unique).2
      have rest_perm : (pre ++ suffix).Perm tail :=
        (move_perm.symm.trans permutation).cons_inv
      have rest_sublist : (pre ++ suffix).Sublist (pre ++ a :: suffix) :=
        (List.sublist_cons_self a suffix).append_left pre
      have rest_order : PreservesConflictOrder independent (pre ++ suffix) tail := by
        intro b c conflict before_rest
        have b_in_rest : b ∈ pre ++ suffix :=
          before_rest.subset (by simp)
        have b_ne_a : b ≠ a := by
          intro equal
          subst b
          exact a_not_in_rest b_in_rest
        have before_source : Before b c (pre ++ a :: suffix) :=
          before_rest.trans rest_sublist
        have before_target : [b, c].Sublist (a :: tail) :=
          order b c conflict before_source
        exact pair_sublist_tail_of_ne b_ne_a before_target
      exact SwapEquivalent.trans move
        (swapEquivalent_prepend independent a
          (ih (pre ++ suffix) rest_unique rest_perm rest_order))

/-- Semantic consequence of the independently proved conflict-order theorem. -/
theorem execute_eq_of_perm_preserving_conflicts
    (update : Label → State → State)
    (independent : Label → Label → Prop)
    (sound : ∀ a b, independent a b → Commutes update a b)
    {first second : List Label} (unique : first.Nodup)
    (permutation : first.Perm second)
    (order : PreservesConflictOrder independent first second)
    (initial : State) :
    execute update first initial = execute update second initial :=
  execute_eq_of_swapEquivalent update independent sound
    (swapEquivalent_of_perm_preserving_conflicts independent
      first second unique permutation order) initial

/-! A sufficient read/write criterion for single-cell updates. -/

section SingleCell

variable {Site : Type u} {Value : Type v} [DecidableEq Site]

/-- `rule i` may depend only on the sites declared by `reads i`. -/
def ReadsOnly (reads : Site → Site → Prop)
    (rule : Site → (Site → Value) → Value) : Prop :=
  ∀ i before after,
    (∀ k, reads i k → before k = after k) →
      rule i before = rule i after

/-- Compute a new value from the old configuration and write only site `i`. -/
def cellUpdate (rule : Site → (Site → Value) → Value)
    (i : Site) (configuration : Site → Value) : Site → Value :=
  fun k => if k = i then rule i configuration else configuration k

theorem rule_eq_after_unread_update
    (reads : Site → Site → Prop)
    (rule : Site → (Site → Value) → Value)
    (locality : ReadsOnly reads rule) {i j : Site}
    (unread : ¬ reads i j) (configuration : Site → Value) :
    rule i (cellUpdate rule j configuration) = rule i configuration := by
  apply locality i
  intro k hk
  have different : k ≠ j := by
    intro equal
    subst k
    exact unread hk
  simp only [cellUpdate, ite_eq_right different]

/--
Updates at distinct sites commute if neither rule reads the other's written
site.  This includes the possibility that both rules read shared third sites.
-/
theorem cellUpdates_commute_of_read_write_disjoint
    (reads : Site → Site → Prop)
    (rule : Site → (Site → Value) → Value)
    (locality : ReadsOnly reads rule) {i j : Site}
    (different : i ≠ j) (i_does_not_read_j : ¬ reads i j)
    (j_does_not_read_i : ¬ reads j i) :
    Commutes (cellUpdate rule) i j := by
  intro configuration
  have different' : j ≠ i := Ne.symm different
  have hi := rule_eq_after_unread_update reads rule locality
    i_does_not_read_j configuration
  have hj := rule_eq_after_unread_update reads rule locality
    j_does_not_read_i configuration
  funext k
  by_cases ki : k = i
  · subst k
    simp only [cellUpdate, ite_eq_right different]
    exact hi.symm
  · by_cases kj : k = j
    · subst k
      simp only [cellUpdate, ite_eq_right different']
      exact hj
    · simp only [cellUpdate, ite_eq_right ki, ite_eq_right kj]

/-- The set of sites consisting of the updated site and its neighbors. -/
def ClosedNeighborhood (adjacent : Site → Site → Prop) (i k : Site) : Prop :=
  k = i ∨ adjacent i k

/--
For a symmetric neighborhood relation, distinct non-neighboring single-cell
updates commute when the local rule reads only the closed neighborhood.
-/
theorem cellUpdates_commute_of_nonadjacent
    (adjacent : Site → Site → Prop)
    (symmetric : ∀ i j, adjacent i j → adjacent j i)
    (rule : Site → (Site → Value) → Value)
    (locality : ReadsOnly (ClosedNeighborhood adjacent) rule)
    {i j : Site} (different : i ≠ j) (nonadjacent : ¬ adjacent i j) :
    Commutes (cellUpdate rule) i j := by
  apply cellUpdates_commute_of_read_write_disjoint
    (ClosedNeighborhood adjacent) rule locality different
  · intro h
    rcases h with equal | neighbor
    · exact different equal.symm
    · exact nonadjacent neighbor
  · intro h
    rcases h with equal | neighbor
    · exact different equal
    · exact nonadjacent (symmetric j i neighbor)

end SingleCell

end MathResearch.Trace

